#!/bin/sh
set -eu

PROJECT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PYTHON="$PROJECT_DIR/.venv/bin/python"

if [ ! -x "$PYTHON" ]; then
    printf '%s\n' "Project virtual environment not found. Set it up first with:" \
        "  python3 -m venv .venv" \
        "  .venv/bin/python -m pip install pikepdf" >&2
    exit 1
fi

exec "$PYTHON" "$PROJECT_DIR/main.py" "$@"
